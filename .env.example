# ==============================================================================
# .env.example — LegalShield AI Environment Variable Template
#
# PURPOSE:
#   This file documents all required and optional environment variables for the
#   LegalShield AI system. Copy this file to `.env` and fill in your actual values.
#
# USAGE:
#   cp .env.example .env
#   # Then edit .env with your actual credentials
#
# SECURITY WARNING:
#   NEVER commit your actual `.env` file to version control.
#   The `.env` file is listed in `.gitignore` to prevent accidental exposure.
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED: Google Gemini API Keys (Multi-Key Configuration)
# ------------------------------------------------------------------------------
# Obtain your API keys from: https://aistudio.google.com/app/api-keys
# LegalShield AI supports MULTIPLE API keys organised into role-based pools.
# This enables smart routing and automatic failover on rate limits (HTTP 429).
#
# PARSER POOL — Used by Agent 1 (The Parser)
# At least one parser key is required.
GEMINI_KEY_PARSER_1=your_key_here
GEMINI_KEY_PARSER_2=your_key_here
#
# ANALYST POOL — Used by Agent 2 (Risk Analyst) and Agent 3 (Protector)
# At least one analyst key is required.
GEMINI_KEY_ANALYST_1=your_key_here
GEMINI_KEY_ANALYST_2=your_key_here

# ------------------------------------------------------------------------------
# DEPRECATED: Legacy Single API Key (Fallback)
# ------------------------------------------------------------------------------
# If the multi-key variables above are NOT set, the system falls back to this
# single key for all agents. This is supported for backward compatibility but
# provides no failover protection. Migrate to the multi-key config above.
# GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# OPTIONAL: Output Directory Configuration
# ------------------------------------------------------------------------------
# The directory where generated risk reports will be saved.
# Defaults to ./output if not set.
OUTPUT_DIR=./output

# ------------------------------------------------------------------------------
# OPTIONAL: Logging Level
# ------------------------------------------------------------------------------
# Controls verbosity of application logs.
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Defaults to INFO if not set.
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# OPTIONAL: MCP Server Configuration
# ------------------------------------------------------------------------------
# Path to the MCP server script. Defaults to mcp_server/document_server.py.
MCP_SERVER_SCRIPT=mcp_server/document_server.py

# ------------------------------------------------------------------------------
# OPTIONAL: Legal Library Path
# ------------------------------------------------------------------------------
# Path to the directory containing legal reference documents.
# Defaults to ./legal_library if not set.
LEGAL_LIBRARY_PATH=./legal_library

# ------------------------------------------------------------------------------
# OPTIONAL: PII Redaction Configuration
# ------------------------------------------------------------------------------
# Set to "true" to enable strict mode (redact ALL capitalized proper nouns).
# Defaults to "false" for standard detection only.
PII_STRICT_MODE=false
