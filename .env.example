# ==============================================================================
# .env.example — LegalShield AI Environment Variable Template
#
# PURPOSE:
#   This file documents all required and optional environment variables for the
#   LegalShield AI system. Copy this file to `.env` and fill in your actual values.
#
# USAGE:
#   cp .env.example .env
#   # Then edit .env with your actual credentials
#
# SECURITY WARNING:
#   NEVER commit your actual `.env` file to version control.
#   The `.env` file is listed in `.gitignore` to prevent accidental exposure.
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED: Google Gemini API Key
# ------------------------------------------------------------------------------
# Obtain your API key from: https://aistudio.google.com/app/api-keys
# This key is used by all three AI agents (Parser, Risk Analyst, Protector).
# It is loaded at runtime and NEVER hardcoded in any source file.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# OPTIONAL: Output Directory Configuration
# ------------------------------------------------------------------------------
# The directory where generated risk reports will be saved.
# Defaults to ./output if not set.
OUTPUT_DIR=./output

# ------------------------------------------------------------------------------
# OPTIONAL: Logging Level
# ------------------------------------------------------------------------------
# Controls verbosity of application logs.
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Defaults to INFO if not set.
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# OPTIONAL: MCP Server Configuration
# ------------------------------------------------------------------------------
# Path to the MCP server script. Defaults to mcp_server/document_server.py.
MCP_SERVER_SCRIPT=mcp_server/document_server.py

# ------------------------------------------------------------------------------
# OPTIONAL: Legal Library Path
# ------------------------------------------------------------------------------
# Path to the directory containing legal reference documents.
# Defaults to ./legal_library if not set.
LEGAL_LIBRARY_PATH=./legal_library

# ------------------------------------------------------------------------------
# OPTIONAL: PII Redaction Configuration
# ------------------------------------------------------------------------------
# Set to "true" to enable strict mode (redact ALL capitalized proper nouns).
# Defaults to "false" for standard detection only.
PII_STRICT_MODE=false
